    }
    
    
    tasks.configureEach { task ->  
    if (task.name.toLowerCase().contains('headless')) {  
        task.dependsOn downloadBlocklists  
        if (task.name.endsWith("BuildConfig")) {  
            task.enabled false  
            }  
        }  
    }  
    splits {  
        abi {  
            enable true  
            reset()  
            include "armeabi-v7a", "arm64-v8a" //, "x86", "x86_64"  
            universalApk true  
        }  
    }  
    //(mantido se desejar duplicado; deixando apenas um para evitar confusao)  
    compileOptions {  
    sourceCompatibility JavaVersion.VERSION_17  
    targetCompatibility JavaVersion.VERSION_17  
    }

}
    configurations {
    download {
    transitive true // default app iss false (bloqueia import conf local e download conf server)
        }
    }
    
   // ========= START generateKeyParts =====================
task generateKeyParts {
    description = "Gera chave AES 128-bit e divide em partes para embedar no binario"
    outputs.file("$buildDir/anti/key_parts.meta")
    doLast {
        def keyBytes = new byte[16] //default 16 AES-128
        new SecureRandom().nextBytes(keyBytes)
        def b64_2 = Base64.getEncoder().encodeToString(keyBytes)
        // dividir em 5 partes pseudo-aleatórias
        def parts = []
        def rnd = new SecureRandom()
        
        
        // cada numero representa um pedaco (uma parte) da chave
        // que sera gerada : 8 numeros abaixo equivale a 8 partes
        // da chave gerada , o antiloader precisa ler 8 valores 
        def lens = [1,3,2,1,3,2,2,2] // a soma entre os valores precisa ser 16
        def offset = 0
        lens.each { ln ->
            def slice = keyBytes[offset..(offset+ln-1)]
            parts << Base64.getEncoder().encodeToString(slice as byte[])
            offset += ln
        }
        def meta = new File("$buildDir/anti/key_parts.meta")
        meta.parentFile.mkdirs()
        meta.text = parts.join("\n")
        println "generateKeyParts -> gravado em: ${meta.absolutePath}"
    }
}
// ========= END generateKeyParts =====================


// ========= START encryptPayload =====================
task encryptPayload(dependsOn: generateKeyParts) {
    description = "Cifra a lista de pacotes (hashes) e cria assets/.anti_data/cache_res_v3.dat"
    def plainListFile = file("tools/anti-packages.txt")

    // altera o nome do payload no build
    outputs.file("$buildDir/outputs/cache_res_v3.dat")

    doLast {
        if (!plainListFile.exists()) {
            println "WARN: tools/anti-packages.txt nao existe. Criando exemplo."
            plainListFile.parentFile.mkdirs()
            plainListFile.text = "com.example.modtool\ncom.mt.mgr\ncom.example.patcher"
        }

        def lines = plainListFile.readLines().findAll { it.trim().length() > 0 }.collect { it.trim() }

        // função local dentro do doLast
        def localSha256 = { String s ->
            java.security.MessageDigest.getInstance("SHA-256")
                .digest(s.getBytes("UTF-8"))
                .collect { String.format("%02x", it) }
                .join()
        }

        // garantir que hashes seja uma lista vazia caso lines esteja vazia
        def hashes = []
        if (lines) {
            hashes = lines.collect { localSha256(it) }
        }

        // adicionar junk hashes
        def rnd = new java.security.SecureRandom()
        (0..<100).each { hashes << localSha256("junk_" + randId(12) + "_" + rnd.nextInt()) }

        hashes = hashes.findAll { it != null }

        // agora é seguro gerar o payload
        def payloadPlain = hashes.join("\n").getBytes("UTF-8")

        // recuperar partes da key
        def keyParts = file("$buildDir/anti/key_parts.meta").readLines()
        def keyBytesList = keyParts.collect { Base64.getDecoder().decode(it) }
        def keyBytes = keyBytesList.collectMany { it.toList() } as byte[]
        def key = new javax.crypto.spec.SecretKeySpec(keyBytes, "AES")

        // IV GCM
        def iv = new byte[12]
        new java.security.SecureRandom().nextBytes(iv)
        def cipher = javax.crypto.Cipher.getInstance("AES/GCM/NoPadding")
        cipher.init(javax.crypto.Cipher.ENCRYPT_MODE, key, new javax.crypto.spec.GCMParameterSpec(128, iv))
        def encrypted = cipher.doFinal(payloadPlain)

        // ==========================================
        // novo nome e novo caminho do arquivo cifrado
        // ==========================================
        def outFile = file("$buildDir/outputs/cache_res_v3.dat")
        outFile.parentFile.mkdirs()
        outFile.withOutputStream { os ->
            os.write(iv)
            os.write(encrypted)
        }

        println "encryptPayload -> criado: ${outFile.absolutePath}"

        // ==============================================================
        // cópia automática para o diretório oculto em assets/.anti_data/
        // ==============================================================
        def hiddenDir = file("src/main/assets/.anti_data")
        hiddenDir.mkdirs()

        def finalAssetFile = file("src/main/assets/.anti_data/cache_res_v3.dat")
        //outFile.copyTo(finalAssetFile, overwrite: true)
        java.nio.file.Files.copy(
        outFile.toPath(),
        finalAssetFile.toPath(),
        java.nio.file.StandardCopyOption.REPLACE_EXISTING
        )

        println "encryptPayload -> copiado para assets oculto: ${finalAssetFile.absolutePath}"
    }
}
// ========= END encryptPayload =====================
// ========= START generateDynamicClasses =====================
task generateDynamicClasses(dependsOn: encryptPayload) {
    description = "Gera classes Kotlin/Java dinâmicas que embutem pedacos da chave e pequenas rotas de verificacao"
    def outDir = file("$buildDir/generated-src/anti")
    outputs.dir outDir
    doLast {
        outDir.deleteDir()
        outDir.mkdirs()
        // ler key parts
        def parts = file("$buildDir/anti/key_parts.meta").readLines()
        // cria N classes, cada uma com um pedaco
        // cria N classes KeyPart0..N
        parts.eachWithIndex { part, idx ->

            def className = "KeyPart${idx}"
            def packageName = "fasofts.element.sysdata"
            def javaSrcDir = new File("$buildDir/generated/source/dynamicClasses/")

            def pkgPath = new File(javaSrcDir, packageName.replace(".", "/"))
            pkgPath.mkdirs()

            def fileK = new File(pkgPath, "${className}.java")

            def code = """
                package ${packageName};

                public class ${className} {
                    public static String getKPart() {
                        return "${part.replace("\"", "\\\"")}";
                    }
                }
            """

            fileK.text = code
            println "Generated class: ${packageName}.${className}"
        }

        // metadata para loader
        def meta = new File("$buildDir/anti/detector_meta.txt")
        //meta.text = "package=$packageName\nclasses=" + parts.size()
        meta.text = "classes=" + parts.size()
        println "generateDynamicClasses -> metadata: ${meta.absolutePath}"
    }
}
// ========= END generateDynamicClasses =====================

// ========= START generateDynamicClasses =====================
task injectAssets(dependsOn: generateDynamicClasses) {
    description = "Copia outputs/cache_res_v3.dat para assets/.anti_data (temporario) e copia classes geradas para compilation"
    doLast {
        // novo nome do payload
        def outPayload = file("$buildDir/outputs/cache_res_v3.dat")
        if (!outPayload.exists()) {
            throw new GradleException("cache_res_v3.dat ausente. Rode encryptPayload.")
        }

        // novo dir oculto
        def assetsDir = file("src/main/assets/.anti_data")
        assetsDir.mkdirs()

        // novo nome
        def target = new File(assetsDir, "cache_res_v3.dat")

        // copiar para assets oculto
        java.nio.file.Files.copy(outPayload.toPath(), target.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING)
        println "injectAssets -> copia para assets oculto: ${target.absolutePath}"

        // copiar classes geradas para src (para compilar)
        def genSrc = file("$buildDir/generated-src/anti")
        if (genSrc.exists()) {
            def dest = file("src/main/java/fasofts/element")
            copy {
                from genSrc
                into dest
            }
            println "injectAssets -> classes geradas copiadas para src/main/java (serao compiladas)"
        } else {
            println "injectAssets -> geracao de classes nao encontrada em ${genSrc}"
        }
    }
}
// ========= END generateDynamicClasses =====================


    
    // =====================================================================
    // ========= ANTI MODDERs integrar tasks ao build =====================
preBuild.dependsOn injectAssets

// se quiser garantir por variant:
android.applicationVariants.all { variant ->
    def assembleTask = variant.assembleProvider
    // as tasks ja sao dependencia de preBuild, e geralmente suficiente, mas garantir:
    assembleTask.configure { dependsOn injectAssets }
}
    // =====================================================================
    // ========= END ANTI MODDERs integrar tasks ao build =====================
   // =====================================================================






task injectAssetss(dependsOn: encryptPayload) {
    doLast {
        def src = file("$buildDir/outputs/cache_res_v3.dat")
        def dst = file("src/main/assets/.anti_data/cache_res_v3.dat")

        dst.parentFile.mkdirs()
        src.withInputStream { input ->
            dst.withOutputStream { out ->
                out << input
            }
        }
        println "injectAssetss -> cache_res_v3.dat copiado para assets/.anti_data."
    }
}

preBuild.dependsOn(injectAssets)



