def randomId = { int len ->
    def chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    def rnd = new SecureRandom()
    (1..len).collect { chars[rnd.nextInt(chars.length())] }.join()
}

// utilitário XOR → gera hex para strings ofuscadas
def xorHex = { String text, String key ->
    def tb = text.getBytes("UTF-8")
    def kb = key.getBytes("UTF-8")
    def out = new byte[tb.length]
    for (int i = 0; i < tb.length; i++)
        out[i] = (byte)(tb[i] ^ kb[i % kb.length])
    return out.collect { String.format("%02x", it & 0xFF) }.join()
}

    task generateStealthClass {
        doLast {
        // Gera um ID aleatório para nome da classe stealth
        def id = randomId(6)
        def className = "S" + id
        def methodName = "m" + randomId(5)

        // Chave XOR usada para ofuscar todas as strings sensíveis
        def xorKey = randomId(6)

        //===========================================================
        // 1) OFUSCAÇÃO DO NOME DO ANTI-LOADER
        //    Proteção: impede renomeação manual do AntiLoader
        //    Como ativar: manter a string original abaixo
        //    Como desativar: substituir por "" (vazio)
        //===========================================================
        def obfAntiLoader = xorHex("fasofts.element.AntiLoader", xorKey)

        //===========================================================
        // 2) VERIFICAÇÃO DA ASSINATURA SHA-256 DO APK
        //    Proteção: impede re-assinatura com chave pirata
        //    Como ativar: colocar SHA-256 real em expectedApkSignature
        //    Como desativar: deixar expectedApkSignature = ""
        //===========================================================
        def expectedApkSignature = "7b5b6da95459d99a7cb5f40c0b3da6df013a5fa89fca3ff077af64e5716c3cd0"
        def obfExpectedSig = expectedApkSignature ? xorHex(expectedApkSignature, xorKey) : ""

        //===========================================================
        // 3) LISTA DE INSTALADORES PERMITIDOS
        //    Proteção: bloqueia sideload, APKs manualmente instalados
        //    Como ativar: deixar 1 ou mais instaladores listados
        //    Como desativar: remover todos e deixar "" ofuscado
        //    /*ex:
        //    def obfInstaller1 = xorHex("", xorKey)
        //    def obfInstaller2 = xorHex("", xorKey)*/
        //===========================================================
        def obfInstaller1 = xorHex("com.google.android.packageinstaller", xorKey) // Instalador nativo (opcional)
        def obfInstaller2 = "" //xorHex("com.android.vending", xorKey)          // Google Play
        def obfInstaller3 = "" //xorHex("com.huawei.appmarket", xorKey)         // Huawei
        

        //===========================================================
        // 4) ANTI-TAMPER: PACKAGE + LABEL
        //    Proteção: impede mudança de:
        //      - applicationId
        //      - label visível do app
        //    Como ativar: manter valores originais
        //    Como desativar: substituir expected por ""
        //===========================================================
        def originalPkg = android.defaultConfig.applicationId
        def originalLabel = "Element"
        def obfPkgHex = xorHex(originalPkg, xorKey)
        def obfLabelHex = xorHex(originalLabel, xorKey)

        //===========================================================
        // Saída da classe stealth gerada
        //===========================================================
        def outDir = file("$buildDir/generated/stealth/${id}")
        outDir.mkdirs()

        def fileKt = new File(outDir, "${className}.kt")

      fileKt.text = """
package fasofts.element.sysdata

import android.app.Activity
import android.content.Context
import java.io.File
import java.security.MessageDigest
import android.util.Base64
import java.lang.reflect.Method
import android.util.Log
import android.content.pm.PackageManager
import android.app.ActivityManager

object ${className} {

    private fun log(x: String) {
        Log.e("STEALTH_${className}", x)
    }

    private fun xorDecode(hex: String, key: String): String {
        return try {
            val data = hex.chunked(2).map { it.toInt(16).toByte() }.toByteArray()
            val k = key.toByteArray(Charsets.UTF_8)
            val out = ByteArray(data.size)
            for (i in data.indices) out[i] = (data[i].toInt() xor k[i % k.size].toInt()).toByte()
            String(out, Charsets.UTF_8)
        } catch (_: Throwable) { "" }
    }

    private val xorKey = "${xorKey}"
    private val obfAntiLoaderHex = "${obfAntiLoader}"
    private val obfExpectedSigHex = "${obfExpectedSig}"
    private val obfInstaller1 = "${obfInstaller1}"
    private val obfInstaller2 = "${obfInstaller2}"
    private val obfInstaller3 = "${obfInstaller3}"
    private val obfPkgHex = "${obfPkgHex}"
    private val obfLabelHex = "${obfLabelHex}"

    //===========================================================
    // 5) DETECÇÃO DE FRIDA
    //===========================================================
    private fun fridaDetected(): Boolean {
        return try {
            val t = File("/proc/self/maps").readText()
            val p = listOf("frida", "gum-js-loop", "libfrida", "re.frida", "frida-agent")
            val hit = p.any { t.contains(it) }
            if (hit) log("FRIDA detectado")
            hit
        } catch (_: Throwable) { false }
    }

    //===========================================================
// 6) DETECÇÃO DE FERRAMENTAS MODDER / VIRTUALIZADORES
//===========================================================
private val knownModPackages = listOf(
    "org.cheatengine",
    "com.gameguardian",
    "com.vphonegaga",
    "com.virtualxposed",
    "io.va.exposed",
    "com.lbe.parallel",
    "com.dualspace.pro",
    "com.parallel.space",
    "ru.maximoff.apktool",
    "bin.mt.plus.canary",
    "bin.mt.plus",
    "com.vphonegaga.titan",
    "com.topjohnwu.magisk",
    "com.kulipai.luahook",
    "org.lsposed.lspatch",
    "com.mt.mtsafe",
    "bin.mt.plus",
    "bin.mt.plus.64",
    "bin.mt.plus.arm64",
    "com.android.vending.billing.InAppBillingService.LUCK",
    "com.chelpus.luckypatcher",
    "com.dimonvideo.luckypatcher",
    "com.luckypatcher.luckypatcher",
    "com.zhiliaoapp.musically",
    "com.kmods.xposed",
    "de.robv.android.xposed.installer",
    "com.topjohnwu.magisk",
    "com.topjohnwu.magisk.debug",
    "com.xposed.installer",
    "org.meowcat.edxposed.manager",
    "io.github.vvb2060.magisk",
    "riru.core",
    "io.github.solohsu.magisk",
    "com.saurik.substrate",
    "com.sandhook.unhook",
    "com.frida.server",
    "com.frida.helper",
    "com.frapetools.frida",
    "com.frapetools.dumpdex",
    "com.guoshi.httpcanary",
    "com.guoshi.httpcanary.premium",
    "app.grey.pipes",
    "com.jac207apps.packagemanagerservice",
    "com.android.dexprotector",
    "com.android.dexeditor",
    "com.hexedit.modder",
    "com.dexprotector.pro",
    "org.lsposed.manager",
    "org.lsposed.lspd"
)

private fun detectModTools(ctx: Context): Boolean {
    Log.e("STEALTH", "detectModTools() EXECUTADO")

    return try {
        val pm = ctx.packageManager
        val installed = pm.getInstalledPackages(PackageManager.MATCH_ALL).map { it.packageName }

        if (installed.any { it in knownModPackages }) {
            Log.e("STEALTH", "Ferramenta modder detectada (instalado)")
            return true
        }

        val am = ctx.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager

        val runningProcesses = am.runningAppProcesses?.map { it.processName } ?: emptyList()
        if (runningProcesses.any { it in knownModPackages }) {
            Log.e("STEALTH", "Ferramenta modder detectada (processo ativo)")
            return true
        }

        val runningServices = am.getRunningServices(Int.MAX_VALUE).map { it.service.packageName }
        if (runningServices.any { it in knownModPackages }) {
            Log.e("STEALTH", "Ferramenta modder detectada (serviço ativo)")
            return true
        }

        false
    } catch (_: Throwable) {
        log("Erro no detectModTools")
        false
    }
}

// NOVO MÉTODO — APENAS ADICIONADO, NADA ALTERADO
fun detectModPackages(context: Context): Boolean {
    val pm = context.packageManager

    val suspicious = listOf(
        "magisk",
        "riru",
        "zygisk",
        "lsposed",
        "edxposed",
        "xposed",
        "frida",
        "substrate",
        "rootcloak",
        "huskydg",
        "sui",
        "hide",
        "patch",
        "cheat",
        "mod"
    )

    val installed = pm.getInstalledPackages(
        PackageManager.GET_META_DATA or
        PackageManager.GET_SHARED_LIBRARY_FILES or
        PackageManager.MATCH_ALL
    )

    for (p in installed) {
        val name = p.packageName.lowercase()

        for (s in suspicious) {
            if (name.contains(s)) {
                return true
            }
        }
    }

    return false
}


    //===========================================================
    // 7) DETECÇÃO DE XPOSED
    //===========================================================
    private fun detectXposed(): Boolean {
        return try {
            Class.forName("de.robv.android.xposed.XposedBridge")
            log("Xposed detectado")
            true
        } catch (_: Throwable) { false }
    }

    //===========================================================
    // 8) ANTI DEBUG / ANTI TRACERPID
    //===========================================================
    private fun memTamper(): Boolean {
        try {
            if (android.os.Debug.isDebuggerConnected()) {
                log("Debugger detectado")
                return true
            }
            val s = File("/proc/self/status").readText()
            val tracerPid = s.lineSequence().firstOrNull { it.startsWith("TracerPid:") }
                ?.split(":")?.getOrNull(1)?.trim()
            if (tracerPid != null && tracerPid != "0") {
                log("TracerPid != 0 detectado (\$tracerPid)")
                return true
            }
        } catch (_: Throwable) {}
        return false
    }

    //===========================================================
    // 9) LEITURA DA ASSINATURA REAL DO APK
    //===========================================================
    private fun apkSignatureSha256(ctx: Context): String {
        return try {
            val pm = ctx.packageManager
            val info = pm.getPackageInfo(ctx.packageName,
                android.content.pm.PackageManager.GET_SIGNING_CERTIFICATES)
            val sigs = if (android.os.Build.VERSION.SDK_INT >= 28)
                info.signingInfo.apkContentsSigners
            else info.signatures
            val md = MessageDigest.getInstance("SHA-256")
            md.digest(sigs[0].toByteArray()).joinToString("") { "%02x".format(it) }
        } catch (_: Throwable) { "" }
    }

    //===========================================================
    // 10) CONFIRMA SE A ASSINATURA LIDA É A MESMA ESPERADA
    //===========================================================
    private fun signatureMatches(ctx: Context): Boolean {
        if (obfExpectedSigHex.isEmpty()) {
            log("Skip assinatura (expected vazio)")
            return true
        }
        return try {
            val expected = xorDecode(obfExpectedSigHex, xorKey)
            val actual = apkSignatureSha256(ctx)
            val ok = actual.equals(expected, ignoreCase = true)
            if (!ok) log("Assinatura incorreta")
            ok
        } catch (_: Throwable) {
            log("Erro em signatureMatches")
            false
        }
    }

    //===========================================================
    // 11) CHECAGEM DO INSTALADOR
    //===========================================================
    /*private fun installerAllowed(ctx: Context): Boolean {
        return try {
            val installer = ctx.packageManager.getInstallerPackageName(ctx.packageName) ?: ""
            val i1 = xorDecode(obfInstaller1, xorKey)
            val i2 = xorDecode(obfInstaller2, xorKey)
            val i3 = xorDecode(obfInstaller3, xorKey)
            val ok = installer == i1 || installer == i2 || installer == i3
            if (!ok) log("Instalador NAO permitido: \$installer")
            ok
                }     catch (_: Throwable) {
            log("Erro no installerAllowed")
            false
            }
        }*/
        
        
        //===========================================================
// 11) CHECAGEM DO INSTALADOR (CORRIGIDO)
//===========================================================
        private fun installerAllowed(ctx: Context): Boolean {
            return try {
                    val installer = ctx.packageManager.getInstallerPackageName(ctx.packageName)
            
                    val allowed = mutableListOf<String>()
            
                    val i1 = xorDecode(obfInstaller1, xorKey)
                    val i2 = xorDecode(obfInstaller2, xorKey)
                    val i3 = xorDecode(obfInstaller3, xorKey)
            
                    if (i1.isNotEmpty()) allowed += i1
                    if (i2.isNotEmpty()) allowed += i2
                    if (i3.isNotEmpty()) allowed += i3
            
                    // Nenhum installer configurado → não bloquear
                    if (allowed.isEmpty()) {
                        log("Installer check desativado (nenhum configurado)")
                        return true
                    }
            
                    // Installer NULL ou vazio NÃO é permitido se há regra ativa
                    if (installer.isNullOrEmpty()) {
                        log("Installer NULL rejeitado")
                        return false
                    }
            
                    val ok = allowed.contains(installer)
                    if (!ok) log("Instalador NAO permitido: $installer")
            
                    ok
            }    catch (_: Throwable) {
                    // Falha de API ≠ adulteração
                    true
                    }
        }

    //===========================================================
    // 12) OWNER / DATA DIR
    //===========================================================
    private fun ownerMatches(ctx: Context): Boolean {
        return try {
            val ok = File(ctx.applicationInfo.dataDir).exists()
            if (!ok) log("ownerMatches = false")
            ok
        } catch (_: Throwable) { false }
    }

    //===========================================================
    // 13) DETECTA ALTERAÇÃO DO PACKAGE NAME
    //===========================================================
    private fun detectPackageTamper(ctx: Context): Boolean {
        return try {
            val expected = xorDecode(obfPkgHex, xorKey)
            val tamper = ctx.packageName != expected
            if (tamper) log("PackageName modificado")
            tamper
        } catch (_: Throwable) {
            log("Erro detectPackageTamper")
            true
        }
    }

    //===========================================================
    // 14) DETECTA ALTERAÇÃO DO LABEL DO APP
    //===========================================================
    private fun detectAppNameChange(ctx: Context): Boolean {
        return try {
            val pm = ctx.packageManager
            val ai = pm.getApplicationInfo(ctx.packageName, 0)
            val name = pm.getApplicationLabel(ai).toString()
            val expected = xorDecode(obfLabelHex, xorKey)
            val tamper = name != expected
            if (tamper) log("Label do app alterado (esperado='\$expected', atual='\$name')")
            tamper
        } catch (_: Throwable) {
            log("Erro detectAppNameChange")
            true
        }
    }

    //===========================================================
    // 15) LIMPA A MEMÓRIA DO OBJETO
    //===========================================================
    private fun cleanup() {
        try {
            this::class.java.declaredFields.forEach {
                it.isAccessible = true
                try { it.set(null, null) } catch (_: Throwable) {}
            }
        } catch (_: Throwable) {}
    }

    //===========================================================
    // 16) FINALIZA O APP QUANDO ALGO É DETECTADO
    //===========================================================
    private fun kill(ctx: Context) {
        log("KILL disparado → app encerrado")
        try { if (ctx is Activity) ctx.finishAffinity() } catch (_: Throwable) {}
        try { android.os.Process.killProcess(android.os.Process.myPid()) } catch (_: Throwable) {}
    }

    //===========================================================
    // 17) MÉTODO PRINCIPAL DE EXECUÇÃO
    //===========================================================
    fun ${methodName}(ctx: Context) {
        log("Stealth iniciado")

        try {
            val loader = xorDecode(obfAntiLoaderHex, xorKey)
            val c = Class.forName(loader)
            val m = c.getMethod("runChecks", Context::class.java)
            val ok = (m.invoke(null, ctx) as Boolean)
            if (!ok) { cleanup(); kill(ctx); return }

            if (fridaDetected()) { cleanup(); kill(ctx); return }
            if (memTamper()) { cleanup(); kill(ctx); return }
            if (detectXposed()) { cleanup(); kill(ctx); return }
            if (detectModTools(ctx)) { cleanup(); kill(ctx); return }
            if (detectPackageTamper(ctx)) { cleanup(); kill(ctx); return }
            if (detectAppNameChange(ctx)) { cleanup(); kill(ctx); return }
            if (!signatureMatches(ctx)) { cleanup(); kill(ctx); return }
            if (!installerAllowed(ctx) || !ownerMatches(ctx)) { cleanup(); kill(ctx); return }

            log("Stealth FINAL OK")
            cleanup()
        } catch (e: Throwable) {
            log("EXCEÇÃO GERAL: " + e.message)
            cleanup(); kill(ctx)
            }
        }
}
"""
    println "Classe stealth gerada: ${className}"
    }
}

task injectStealth(dependsOn: generateStealthClass) {
    doLast {
        def srcDir = file("$buildDir/generated/stealth")
        if (!srcDir.exists()) return

        //def destDir = file("src/main/java/fasofts/element/.sysdata")
        def destDir = file("$buildDir/generated/source/dynamicClasses/.sysdata")
        destDir.mkdirs()

        copy {
            from srcDir
            into destDir
        }
        println "Classe stealth injetada em .sysdata/"
    }
}

preBuild.dependsOn(injectStealth)
// =================================================================  
// ================= END CLASSE SECURE ALEATORIA =================  
// =================================================================

    
    // =================================================================  
    // ================= START ASSINATURA XML DEX WHITELIST ===============  
    // =================================================================  

 ext.protectedXmlPatterns = [
    "src/main/res/drawable/**/*.xml",
    "src/main/res/layout/**/*.xml",
    "src/main/res/menu/**/*.xml",
    "src/main/res/mipmap/**/*.xml",
    "src/main/res/mipmap-anydpi-v26/**/*.xml",
    "src/main/res/values/**/*.xml",  
