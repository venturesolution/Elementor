// =========== FUNCAO SHA-256 DO CERTIFICADO DO KEYSTORE ===============
// =====================================================================
def sha256Hex = { byte[] bytes ->
    MessageDigest.getInstance("SHA-256")
            .digest(bytes)
            .collect { String.format("%02x", it) }
            .join()
}

// =====================================================================
// ========== CARREGA SHA-256 DO CERTIFICADO DO BUILD TYPE =============
// =====================================================================
def certShaFor = { signingCfg ->
    if (signingCfg == null) return ""

    def storeFile = signingCfg.storeFile
    def storePass = signingCfg.storePassword
    def keyAlias  = signingCfg.keyAlias

    if (!storeFile || !storePass || !keyAlias) return ""

    for (def type in ["JKS", "PKCS12"]) {
        try {
            def ks = KeyStore.getInstance(type)
            ks.load(new FileInputStream(storeFile), storePass.toCharArray())

            def cert = ks.getCertificate(keyAlias)
            if (cert != null)
                return sha256Hex(cert.getEncoded())

        } catch (Throwable ignore) { }
    }

    return ""
}

def b64 = { byte[] bytes -> java.util.Base64.encoder.encodeToString(bytes) }
