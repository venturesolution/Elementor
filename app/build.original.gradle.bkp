// utilitário XOR → gera hex para strings ofuscadas
def xorHex = { String text, String key ->
    def tb = text.getBytes("UTF-8")
    def kb = key.getBytes("UTF-8")
    def out = new byte[tb.length]
    for (int i = 0; i < tb.length; i++)
        out[i] = (byte)(tb[i] ^ kb[i % kb.length])
    return out.collect { String.format("%02x", it & 0xFF) }.join()
}

task generateStealthClass {
    doLast {
        def id = randomId(6)
        def className = "S" + id
        def methodName = "m" + randomId(5)

        def xorKey = randomId(6)

        def obfAntiLoader = xorHex("fasofts.element.AntiLoader", xorKey)

        def expectedApkSignature = ""
        def obfExpectedSig = expectedApkSignature ? xorHex(expectedApkSignature, xorKey) : ""

        def obfInstaller1 = xorHex("com.android.vending", xorKey)
        def obfInstaller2 = xorHex("com.huawei.appmarket", xorKey)

        def outDir = file("$buildDir/generated/stealth/${id}")
        outDir.mkdirs()

        def fileKt = new File(outDir, "${className}.kt")

        fileKt.text = """
package fasofts.element.sysdata

import android.app.Activity
import android.content.Context
import java.io.File
import java.security.MessageDigest
import android.util.Base64
import android.os.Build

object ${className} {

    private fun xorDecode(hex: String, key: String): String {
        return try {
            val data = hex.chunked(2).map { it.toInt(16).toByte() }.toByteArray()
            val k = key.toByteArray(Charsets.UTF_8)
            val out = ByteArray(data.size)
            for (i in data.indices) out[i] = (data[i].toInt() xor k[i % k.size].toInt()).toByte()
            String(out, Charsets.UTF_8)
        } catch (_: Throwable) { "" }
    }

    private val xorKey = "${xorKey}"
    private val obfAntiLoaderHex = "${obfAntiLoader}"
    private val obfExpectedSigHex = "${obfExpectedSig}"
    private val obfInstaller1 = "${obfInstaller1}"
    private val obfInstaller2 = "${obfInstaller2}"

    // ---------------- ANTI FRIDA ----------------
    private fun fridaDetected(): Boolean {
        return try {
            val maps = File("/proc/self/maps").readText()
            val probes = listOf("frida", "gum-js-loop", "libfrida", "frida-agent", "re.frida")
            probes.any { maps.contains(it) }
        } catch (_: Throwable) { false }
    }

    // ---------------- ANTI GAME GUARDIAN ----------------
    private fun detectGameGuardian(): Boolean {
        val suspicious = listOf(
            "com.gameguardian",
            "com.dingdongda.xposed",
            "com.virtualxposed",
            "com.xposed",
            "com.lbe.parallel",
            "com.excelliance.dualaid"
        )
        return suspicious.any { pkg ->
            try {
                File("/data/data/\$pkg").exists()
            } catch (_: Throwable) { false }
        }
    }

    // ---------------- ANTI VPHONE GAGA ----------------
    private fun detectVPhoneGaga(): Boolean {
        val indicators = listOf("vphonegaga", "gaga", "com.vphonegaga")
        return indicators.any { k ->
            try { File("/proc/self/maps").readText().contains(k) } catch (_: Throwable) { false }
        }
    }

    // ---------------- ANTI XPOSED / VIRTUALXPOSED ----------------
    private fun detectXposed(): Boolean {
        return try {
            val xp = arrayOf(
                "de.robv.android.xposed.XposedBridge",
                "com.android.internal.os.ZygoteInit"
            )
            xp.any {
                try { Class.forName(it) != null } catch (e: Throwable) { false }
            }
        } catch (_: Throwable) { false }
    }

    // ---------------- ANTI EMULADOR ----------------
    private fun detectEmulator(): Boolean {
        val keywords = listOf("vbox", "genymotion", "nox", "sdk_gphone", "emulator")
        val fp = Build.FINGERPRINT.lowercase()
        return keywords.any { fp.contains(it) }
    }

    // ---------------- ANTI MAGISK ----------------
    private fun detectMagisk(): Boolean {
        val paths = listOf(
            "/sbin/magisk", "/data/adb/magisk", "/cache/magisk", "/system/bin/magisk"
        )
        return paths.any { File(it).exists() }
    }

    // ---------------- ANTI DEBUG / MEM PATCH ----------------
    private fun memTamper(): Boolean {
        try {
            if (android.os.Debug.isDebuggerConnected()) return true
            val status = File("/proc/self/status").readText()
            val tracer = status.lineSequence().firstOrNull { it.startsWith("TracerPid:") }
                ?.split(":")?.getOrNull(1)?.trim()
            if (tracer != null && tracer != "0") return true
        } catch (_: Throwable) {}
        return false
    }

    // ---------------- ANTI LD_PRELOAD ----------------
    private fun detectLDPreload(): Boolean {
        return try {
            val env = File("/proc/self/environ").readText()
            env.contains("LD_PRELOAD")
        } catch (_: Throwable) { false }
    }

    // ---------------- ANTI ASSINATURA ----------------
    private fun apkSignatureSha256(ctx: Context): String {
        return try {
            val pm = ctx.packageManager
            val info = pm.getPackageInfo(
                ctx.packageName,
                android.content.pm.PackageManager.GET_SIGNING_CERTIFICATES
            )
            val sigs = if (Build.VERSION.SDK_INT >= 28)
                info.signingInfo.apkContentsSigners
            else info.signatures

            val md = MessageDigest.getInstance("SHA-256")
            val digest = md.digest(sigs[0].toByteArray())
            digest.joinToString("") { "%02x".format(it) }
        } catch (_: Throwable) { "" }
    }

    private fun signatureMatches(ctx: Context): Boolean {
        return try {
            if (obfExpectedSigHex.isEmpty()) return true
            val expected = xorDecode(obfExpectedSigHex, xorKey)
            val actual = apkSignatureSha256(ctx)
            actual.equals(expected, ignoreCase = true)
        } catch (_: Throwable) { false }
    }

    private fun installerAllowed(ctx: Context): Boolean {
        return try {
            val pm = ctx.packageManager
            val installer = pm.getInstallerPackageName(ctx.packageName) ?: return false
            val i1 = xorDecode(obfInstaller1, xorKey)
            val i2 = xorDecode(obfInstaller2, xorKey)
            installer == i1 || installer == i2
        } catch (_: Throwable) { false }
    }

    private fun ownerMatches(ctx: Context): Boolean {
        return try {
            File(ctx.applicationInfo.dataDir).exists()
        } catch (_: Throwable) { false }
    }

    private fun cleanup() {
        try {
            val f = this::class.java.declaredFields
            f.forEach {
                it.isAccessible = true
                try { it.set(null, null) } catch (_: Throwable) {}
            }
        } catch (_: Throwable) {}
    }

    private fun kill(ctx: Context) {
        try { if (ctx is Activity) ctx.finishAffinity() } catch (_: Throwable) {}
        try { android.os.Process.killProcess(android.os.Process.myPid()) } catch (_: Throwable) {}
    }

    // ---------------- MÉTODO PÚBLICO ----------------
    fun ${methodName}(ctx: Context) {
        try {
            val loaderName = xorDecode(obfAntiLoaderHex, xorKey)
            val c = Class.forName(loaderName)
            val m = c.getMethod("runChecks", Context::class.java)
            val ok = (m.invoke(null, ctx) as Boolean)

            if (!ok) { cleanup(); kill(ctx); return }

            if (
                fridaDetected()
                || detectGameGuardian()
                || detectVPhoneGaga()
                || detectXposed()
                || detectMagisk()
                || detectEmulator()
                || detectLDPreload()
                || memTamper()
                || !signatureMatches(ctx)
                || !installerAllowed(ctx)
                || !ownerMatches(ctx)
            ) {
                cleanup(); kill(ctx); return
            }

            cleanup()

        } catch (_: Throwable) {
            cleanup()
            kill(ctx)
        }
    }
}
