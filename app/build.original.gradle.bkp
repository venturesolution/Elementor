// substitua a implementação antiga por esta (mais robusta e com logs)
def getKeyPairFromSigning = { signingCfg ->
    if (signingCfg == null) return null

    // normalize storeFile para java.io.File
    def storeFile = signingCfg.storeFile
    if (storeFile == null) {
        println "DEBUG: signingCfg.storeFile == null"
        return null
    }
    try { storeFile = (storeFile instanceof File) ? storeFile : file(storeFile.toString()) } catch (e) { storeFile = file(storeFile.toString()) }

    def storePass = signingCfg.storePassword?.toString()
    def keyAlias  = signingCfg.keyAlias?.toString()
    def keyPass   = (signingCfg.hasProperty("keyPassword") && signingCfg.keyPassword != null) ? signingCfg.keyPassword.toString() : (storePass ?: "")

    println "DEBUG getKeyPairFromSigning -> file=${storeFile?.absolutePath}, exists=${storeFile?.exists()}, keyAlias='${keyAlias}', storePassPresent=${storePass ? 'yes':'no'}, keyPassPresent=${keyPass ? 'yes':'no'}"

    if (!storeFile || !storeFile.exists()) {
        println "DEBUG: keystore not found at ${storeFile}"
        return null
    }
    if (!keyAlias) {
        println "DEBUG: keyAlias is empty"
        return null
    }

    for (def type in ["JKS", "PKCS12"]) {
        try {
            println "DEBUG: try KeyStore type ${type}"
            def ks = KeyStore.getInstance(type)
            ks.load(new FileInputStream(storeFile), (storePass ?: "").toCharArray())

            // listar aliases para debug
            def aliases = []
            def en = ks.aliases()
            while (en.hasMoreElements()) { aliases << en.nextElement() }
            println "DEBUG: aliases in keystore: ${aliases}"

            def key = ks.getKey(keyAlias, (keyPass ?: "").toCharArray())
            def cert = ks.getCertificate(keyAlias)
            if (key != null && cert != null) {
                println "DEBUG: loaded privateKey and cert (type=${type}) for alias='${keyAlias}'"
                return [ privateKey: key, certificate: cert ]
            } else {
                println "DEBUG: key/cert null for alias='${keyAlias}' in type=${type}"
            }
        } catch (Throwable e) {
            println "DEBUG: error loading keystore type ${type}: ${e.class.name}: ${e.message}"
        }
    }
    println "DEBUG: getKeyPairFromSigning -> returning null after trying all types"
    return null
}
