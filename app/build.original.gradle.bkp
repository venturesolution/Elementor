String sha256Hex(String s) {
    return MessageDigest.getInstance("SHA-256")
            .digest(s.getBytes("UTF-8"))
            .collect { String.format("%02x", it) }
            .join()
}

def randId(int len = 12) {
    def r = new SecureRandom()
    def sb = new StringBuilder()
    def chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    (0..<len).each { sb.append(chars.charAt(r.nextInt(chars.length()))) }
    return sb.toString()
}



